{% extends "base.twig" %}

{% block title %}Declaradas duplicadas - Sistema de Bibliografía{% endblock %}

{% block head %}
<style>
    .dup-asignaturas { max-height: 170px; overflow-y: auto; min-width: 220px; }
    .dup-tabla { font-size: .85rem; }
    .dup-opciones label { display: block; white-space: nowrap; cursor: pointer; }
</style>
{% endblock %}

{% macro autores(fila) %}{% for a in fila.autores %}<div>{{ a }}</div>{% else %}<span class="text-muted">Sin autores</span>{% endfor %}{% endmacro %}
{% macro asignaturas(fila) %}<div class="dup-asignaturas">{% for a in fila.asignaturas %}<div>{{ a.nombre }} <span class="text-muted">({{ a.tipo }})</span></div>{% else %}<span class="text-muted">Sin asignaturas</span>{% endfor %}</div>{% endmacro %}

{% block content %}
{% import _self as m %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h1 class="mb-1">Bibliografías declaradas duplicadas</h1>
            <p class="text-muted mb-0">{{ grupos|length }} grupo(s) con {{ total_declaradas }} bibliografías. Coinciden en título y año, y comparten al menos un apellido de autor.</p>
        </div>
        <a href="{{ app_url }}bibliografias-declaradas" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i> Volver</a>
    </div>

    {% for fila_grupo in grupos %}
    <div class="card shadow mb-3">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <strong>Grupo {{ loop.index }}: {{ fila_grupo[0].titulo }}</strong>
            <button type="button" class="btn btn-primary btn-sm" data-analizar="{{ loop.index0 }}"><i class="fas fa-search me-1"></i> Analizar</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped mb-0 dup-tabla">
                    <thead class="table-light"><tr><th>ID</th><th>Título</th><th>Autor(es)</th><th>Año</th><th>Asignaturas</th><th class="text-center">Disponibles</th></tr></thead>
                    <tbody>
                        {% for fila in fila_grupo %}
                        <tr>
                            <td><a href="{{ app_url }}bibliografias-declaradas/{{ fila.id }}" target="_blank" rel="noopener">{{ fila.id }}</a></td>
                            <td>{{ fila.titulo }}</td>
                            <td>{{ m.autores(fila) }}</td>
                            <td>{{ fila.anio ?: 's/a' }}</td>
                            <td>{{ m.asignaturas(fila) }}</td>
                            <td class="text-center">{{ fila.n_disponibles }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {% else %}
    <div class="card shadow"><div class="card-body text-center text-muted py-5">No se encontraron bibliografías declaradas duplicadas.</div></div>
    {% endfor %}
</div>

<div class="modal fade" id="modalGrupo" tabindex="-1" aria-labelledby="modalGrupoTitulo" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalGrupoTitulo">Analizar grupo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted">Elija una opción por bibliografía. <strong>Mantener</strong> recibe las asignaturas y disponibles de las que se fusionan. <strong>Fusionar</strong> traspasa todo a la que se mantiene y la elimina. <strong>Eliminar</strong> solo está disponible si no tiene asignaturas ni disponibles.</p>
                <div class="table-responsive">
                    <table class="table table-bordered align-middle dup-tabla mb-0">
                        <thead class="table-light"><tr><th>ID</th><th>Título</th><th>Autor(es)</th><th>Año</th><th>Asignaturas</th><th class="text-center">Disponibles</th><th>Opción</th></tr></thead>
                        <tbody id="cuerpoGrupo"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="btnRevisar"><i class="fas fa-check me-1"></i> Revisar y aplicar</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
(function () {
    const GRUPOS = {{ grupos|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }};
    const URL_BASE = {{ (app_url ~ 'bibliografias-declaradas')|json_encode|raw }};
    const modal = new bootstrap.Modal(document.getElementById('modalGrupo'));
    const cuerpo = document.getElementById('cuerpoGrupo');
    const OPCIONES = [['mantener', 'Mantener'], ['fusionar', 'Fusionar'], ['eliminar', 'Eliminar'], ['no_tocar', 'No tocar']];
    let grupoActual = null;

    function esc(valor) {
        const d = document.createElement('div');
        d.textContent = valor === null || valor === undefined ? '' : String(valor);
        return d.innerHTML;
    }

    function celdaOpciones(fila) {
        const eliminable = fila.asignaturas.length === 0 && fila.n_disponibles === 0;
        return OPCIONES.map(([valor, texto]) => {
            const bloqueado = valor === 'eliminar' && !eliminable;
            const marcado = valor === 'no_tocar' ? ' checked' : '';
            return `<label class="${bloqueado ? 'text-muted' : ''}"${bloqueado ? ' title="Tiene asignaturas o disponibles vinculadas"' : ''}><input type="radio" class="form-check-input me-1" name="accion_${fila.id}" value="${valor}" data-id="${fila.id}"${marcado}${bloqueado ? ' disabled' : ''}>${texto}</label>`;
        }).join('');
    }

    function pintarGrupo(indice) {
        grupoActual = GRUPOS[indice];
        document.getElementById('modalGrupoTitulo').textContent = 'Analizar grupo ' + (indice + 1);
        cuerpo.innerHTML = grupoActual.map(fila => `<tr>
            <td><a href="${esc(URL_BASE)}/${parseInt(fila.id, 10)}" target="_blank" rel="noopener">${parseInt(fila.id, 10)}</a></td>
            <td>${esc(fila.titulo)}</td>
            <td>${fila.autores.map(a => `<div>${esc(a)}</div>`).join('') || '<span class="text-muted">Sin autores</span>'}</td>
            <td>${fila.anio ? parseInt(fila.anio, 10) : 's/a'}</td>
            <td><div class="dup-asignaturas">${fila.asignaturas.map(a => `<div>${esc(a.nombre)} <span class="text-muted">(${esc(a.tipo)})</span></div>`).join('') || '<span class="text-muted">Sin asignaturas</span>'}</div></td>
            <td class="text-center">${parseInt(fila.n_disponibles, 10)}</td>
            <td class="dup-opciones">${celdaOpciones(fila)}</td>
        </tr>`).join('');
    }

    // Solo una por grupo puede mantenerse
    cuerpo.addEventListener('change', e => {
        if (e.target.value !== 'mantener') return;
        cuerpo.querySelectorAll('input[value="mantener"]:checked').forEach(r => {
            if (r !== e.target) {
                cuerpo.querySelector(`input[name="accion_${r.dataset.id}"][value="no_tocar"]`).checked = true;
            }
        });
    });

    function acciones() {
        const datos = {};
        cuerpo.querySelectorAll('input[type="radio"]:checked').forEach(r => { datos[r.dataset.id] = r.value; });
        return datos;
    }

    async function pedir(ruta, datos) {
        const resp = await fetch(URL_BASE + '/duplicadas/' + ruta, {method: 'POST', headers: {'Content-Type': 'application/json', 'Accept': 'application/json'}, body: JSON.stringify({acciones: datos})});
        let r = {};
        try { r = await resp.json(); } catch (e) { r = {}; }
        if (!resp.ok || !r.success) throw new Error(r.message || 'No se pudo procesar la solicitud');
        return r;
    }

    function lista(lineas) {
        return '<ul class="text-start small mb-0">' + lineas.map(l => `<li>${esc(l)}</li>`).join('') + '</ul>';
    }

    document.getElementById('btnRevisar').addEventListener('click', async () => {
        const datos = acciones();
        try {
            const previa = await pedir('previsualizar', datos);
            const conf = await Swal.fire({
                title: '¿Aplicar estos cambios?',
                html: lista(previa.resumen) + '<p class="small text-danger mt-3 mb-0">Se eliminarán datos. Quedará una copia en el historial, pero no se puede deshacer desde el sistema.</p>',
                icon: 'warning', showCancelButton: true, confirmButtonText: 'Sí, aplicar', cancelButtonText: 'Cancelar', confirmButtonColor: '#d33'
            });
            if (!conf.isConfirmed) return;
            const r = await pedir('resolver', datos);
            modal.hide();
            await Swal.fire({title: 'Cambios aplicados', html: lista(r.resumen), icon: 'success'});
            window.location.reload();
        } catch (e) {
            Swal.fire({title: 'No se aplicó', text: e.message, icon: 'error'});
        }
    });

    document.querySelectorAll('[data-analizar]').forEach(b => b.addEventListener('click', () => {
        pintarGrupo(parseInt(b.dataset.analizar, 10));
        modal.show();
    }));
})();
</script>
{% endblock %}
